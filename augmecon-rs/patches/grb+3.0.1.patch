@@ -0,0 +1,57 @@
+//! Reproducer for ykrist/rust-grb#27: `add_constrs` disagreeing with
+//! `add_constr`.
+//!
+//! The issue reports two symptoms from one cause. A small model comes back
+//! infeasible where the same constraints added one at a time solve to 2; a
+//! larger one crashes Gurobi with heap corruption or an access violation.
+//!
+//! Both follow from `numnz`. `GRBaddconstrs` is told how many *nonzeros* the
+//! `cind`/`cval` arrays hold, and the wrapper passed `cbeg.len()`, the number
+//! of *constraints*. Here that is 2 against the 4 nonzeros two `x + y` rows
+//! need, so Gurobi builds only part of the second row and the model it solves
+//! is not the one that was described. On a model whose `cbeg` entries reach far
+//! past an understated `numnz`, the same mistake reads off the end of the
+//! arrays instead, which is where the crashes come from.
+//!
+//! Run: `cargo run --example issue27 --features gurobi12`
+
+use grb::prelude::*;
+
+fn main() -> grb::Result<()> {
+    let optimum = |batched: bool| -> grb::Result<f64> {
+        let mut model = Model::new("issue27")?;
+        model.set_param(param::OutputFlag, 0)?;
+        let x = add_ctsvar!(model, bounds: 0..1)?;
+        let y = add_ctsvar!(model, bounds: 0..1)?;
+        model.set_objective(x + y, ModelSense::Minimize)?;
+
+        if batched {
+            model.add_constrs([
+                (&"c1", c!(x + y >= 0.5)),
+                (&"c2", c!(x + y >= 2.0)),
+            ])?;
+        } else {
+            model.add_constr("c1", c!(x + y >= 0.5))?;
+            model.add_constr("c2", c!(x + y >= 2.0))?;
+        }
+        model.optimize()?;
+        assert_eq!(
+            model.status()?,
+            Status::Optimal,
+            "{} model was not solved to optimality",
+            if batched { "batched" } else { "one-at-a-time" }
+        );
+        model.get_attr(attr::ObjVal)
+    };
+
+    let one_at_a_time = optimum(false)?;
+    let batched = optimum(true)?;
+    println!("add_constr  (one at a time): {one_at_a_time}");
+    println!("add_constrs (batched)      : {batched}");
+    assert!(
+        (one_at_a_time - batched).abs() < 1e-9,
+        "add_constrs built a different model than add_constr"
+    );
+    println!("EQUIVALENT: add_constrs matches add_constr");
+    Ok(())
+}
